# Production path: browser calls our backend, backend runs the cutout model.
VITE_VILO_CUTOUT_ENDPOINT=http://127.0.0.1:8787/api/cutout
VITE_VILO_REMOTE_CUTOUT_MODEL=isnet-general-use

# Python cutout API settings.
VILO_CUTOUT_MODEL=isnet-general-use
VILO_MAX_UPLOAD_MB=12
VILO_MAX_INPUT_PIXELS=9000000
VILO_CORS_ORIGINS=http://127.0.0.1:5188,http://localhost:5188

# Optional quick local model candidates:
# VITE_VILO_REMOTE_CUTOUT_MODEL=u2netp
# VITE_VILO_REMOTE_CUTOUT_MODEL=silueta
# VITE_VILO_REMOTE_CUTOUT_MODEL=birefnet-general-lite

# Pick one provider for the local Vite /api/cutout middleware.
# This is now secondary; the Python service is the main production path.
# VILO_CUTOUT_PROVIDER=remove-bg
# REMOVE_BG_API_KEY=...

# VILO_CUTOUT_PROVIDER=clipdrop
# CLIPDROP_API_KEY=...

# Test-only mock used by npm run qa:sticker:api.
# VILO_CUTOUT_MOCK=sample
