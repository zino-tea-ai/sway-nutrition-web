# Browser-facing endpoint. Keep API keys on the server side only.
VITE_VILO_CUTOUT_ENDPOINT=/api/cutout

# Pick one provider for the local Vite /api/cutout middleware.
# VILO_CUTOUT_PROVIDER=remove-bg
# REMOVE_BG_API_KEY=...

# VILO_CUTOUT_PROVIDER=clipdrop
# CLIPDROP_API_KEY=...

# Test-only mock used by npm run qa:sticker:api.
# VILO_CUTOUT_MOCK=sample
